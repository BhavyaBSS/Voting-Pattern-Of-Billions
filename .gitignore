*.pem
*.key
*.cert
secrets.json
credentials.json

# ------------------------------------------------------------------------------
# Large Data & Archive Files (GitHub enforces a 100 MB max file size limit)
# ------------------------------------------------------------------------------
# Compressed archives (uncomment or add raw dump archives if any are created)
*.zip
*.tar.gz
*.rar
*.7z
*.gz
*.iso

# Raw heavy database / dump files
*.sql
*.sqlite3
*.db
*.log
*.dump

# Note: The project's curated assignment datasets in `Datasets/` and `Final Dataset.xlsx`
# are lightweight (< 1 MB each) and safely tracked for report reproducibility.
